# Copiá este archivo como .env.local para probar con `vercel dev`.
# En producción, cargá estas variables en Vercel → Settings → Environment Variables.

# Supabase → Project Settings → Data API (Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Publishable key ("sb_publishable_…"). Se entrega al navegador: es segura porque la base usa RLS.
# (También funciona la clave "anon" clásica con el nombre SUPABASE_ANON_KEY.)
SUPABASE_PUBLISHABLE_KEY=

# Secret key ("sb_secret_…"). SOLO servidor. Nunca la pongas en el HTML ni en GitHub.
# (También funciona la clave "service_role" clásica con el nombre SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=
